# Breek Market frontend configuration.
# Copy to .env.local for development, or set these in the Vercel dashboard.

# Address of the deployed BreekForecast Intelligent Contract.
VITE_BREEK_CONTRACT=0x4aDb6a8f9D0B920cC5699F75060324575C01E19a

# GenLayer network. studionet is chain 61999 at https://studio.genlayer.com/api
VITE_BREEK_CHAIN_ID=61999
VITE_BREEK_RPC=https://studio.genlayer.com/api
VITE_BREEK_NETWORK=studionet
VITE_BREEK_EXPLORER=https://explorer-studio.genlayer.com
